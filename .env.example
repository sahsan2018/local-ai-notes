# Copy to .env for local development. Never commit .env.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-development-value
DATABASE_URL=sqlite:///./data/notes.db
ATTACHMENTS_DIR=/data/attachments
EXPORTS_DIR=/data/exports
LOG_LEVEL=INFO

# Optional AI services; the core application must work without them.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8001/v1
AI_MODEL=
AI_API_KEY=
